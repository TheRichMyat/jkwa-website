# Copy to .env.local and fill in. Also set the same variables in Netlify
# (Site configuration → Environment variables). New sb_publishable_/sb_secret_
# keys and legacy anon/service_role keys both work in these two variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Bypasses all security rules. Never use it in client code or in
# any NEXT_PUBLIC_ variable; only files that import "server-only" may read it.
SUPABASE_SECRET_KEY=

# The site's own address, no trailing slash (http://localhost:3000 locally,
# https://<client-domain> in Netlify's Production context). Canonical, Open
# Graph, JSON-LD and sitemap URLs all use it.
NEXT_PUBLIC_SITE_URL=

# "true" ONLY in Netlify's Production context: lets search engines index the
# site. Anything else (unset on branch deploys and locally) sends
# "Disallow: /" in robots.txt and a noindex tag on every page.
ALLOW_INDEXING=

# Optional: the Google Search Console "HTML tag" verification code (just the
# content="…" value). Output as <meta name="google-site-verification">.
GOOGLE_SITE_VERIFICATION=
